---
import { existsSync, readFileSync, statSync } from "node:fs";
import Capture from "./Capture.astro";
import { findAsset } from "../lib/media.mjs";
const base = import.meta.env.BASE_URL;
const workbook = findAsset("cataloger-excel-report");
// Real exports keep the tool's own file names; the fixtures use the other set.
const stem = existsSync("public/reports/MediaCataloger_All.json")
  ? "MediaCataloger_All"
  : "cataloger-report";
const size = (extension: string) => {
  const bytes = statSync(`public/reports/${stem}.${extension}`).size;
  return bytes < 1024 * 1024
    ? `${Math.max(1, Math.round(bytes / 1024))} KB`
    : `${(bytes / 1024 / 1024).toFixed(1)} MB`;
};
// A real report can have thousands of lines, so the page shows only the start
// of it and the download holds the rest.
const excerpt = (extension: string, maxLines: number) => {
  const lines = readFileSync(`public/reports/${stem}.${extension}`, "utf8")
    .replace(/^\uFEFF/, "")
    .split(/\r?\n/);
  if (lines.length <= maxLines) return lines.join("\n");
  return `${lines.slice(0, maxLines).join("\n")}\n… ${lines.length - maxLines} more lines in the download`;
};
const txt = excerpt("txt", 60);
const json = excerpt("json", 80);
---

<p>
  {stem === "cataloger-report"
    ? "Example reports for illustration."
    : "Reports generated by Media Cataloger from a sample library."}
</p>
<div class="report-previews">
  <article class="report-format">
    <div class="report-heading">
      <h3>Excel workbook</h3>
      <a class="text-link" href={`${base}reports/${stem}.xlsx`} download>
        Download XLSX ({size("xlsx")}) ↓
      </a>
    </div>
    <p>A sortable overview of files, containers and video properties.</p>
    <Capture
      asset={workbook.file}
      width={workbook.width}
      height={workbook.height}
      title="Excel report preview"
      caption={workbook.real ? "Workbook overview." : "Illustrated workbook."}
    />
  </article>
  <article class="report-format">
    <div class="report-heading">
      <h3>TXT report</h3>
      <a class="text-link" href={`${base}reports/${stem}.txt`} download>
        Download TXT ({size("txt")}) ↓
      </a>
    </div>
    <p>A readable inventory you can open in any text editor.</p>
    <details>
      <summary>View TXT report</summary>
      <pre><code>{txt}</code></pre>
    </details>
  </article>
  <article class="report-format">
    <div class="report-heading">
      <h3>JSON report</h3>
      <a class="text-link" href={`${base}reports/${stem}.json`} download>
        Download JSON ({size("json")}) ↓
      </a>
    </div>
    <p>Structured file and stream data for further processing.</p>
    <details>
      <summary>View JSON report</summary>
      <pre><code>{json}</code></pre>
    </details>
  </article>
</div>
