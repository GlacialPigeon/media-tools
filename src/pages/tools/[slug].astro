---
import ProductGuide from "../../components/ProductGuide.astro";
import ProductTechnical from "../../components/ProductTechnical.astro";
import ProductNavigation from "../../components/ProductNavigation.astro";
import ReportPreviews from "../../components/ReportPreviews.astro";
import Capture from "../../components/Capture.astro";
import Layout from "../../layouts/Layout.astro";
import Demo from "../../components/Demo.astro";
import LibraryTest from "../../components/LibraryTest.astro";
import { tools, github } from "../../data/tools";
import { findAsset, findVideo, videoSize } from "../../lib/media.mjs";
export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}
const { tool: t } = Astro.props;
const base = import.meta.env.BASE_URL;
const terminal = findAsset(`${t.slug}-terminal`);
const walkthrough = findAsset(`${t.slug}-walkthrough`);
const video = findVideo(t.slug);
const walkthroughSize = video
  ? videoSize(`public/media/${video}`)
  : walkthrough;
---

<Layout title={`${t.name} — Media Tools`} description={t.description}>
  <section class={`wrap product-hero ${t.color}`}>
    <a class="breadcrumb" href={`${base}#tools`}>
      ← All tools
    </a>
    <div class="eyebrow">{t.name.toUpperCase()}</div>
    <h1>
      {t.headline.split("\n").map((line) => (
        <>
          {line}
          <br />
        </>
      ))}
    </h1>
    <p class="lead">{t.description}</p>
    <div class="actions">
      <a class="button primary" href="#guide">
        Get started →
      </a>
      <a
        class="text-link"
        href={`${github}${t.repo}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        View source on GitHub ↗
      </a>
      <a
        class="text-link"
        href={`${github}${t.repo}/releases`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Releases ↗
      </a>
    </div>
    <p class="muted">
      Windows + Linux · Python 3.10+ · Standalone terminal tool
    </p>
  </section>
  <ProductNavigation />
  <div id="overview" data-product-panel>
    {t.slug === "trickplay-generator" && (
      <>
        <section class="wrap section demo-section">
          <div class="section-heading">
            <div>
              <div class="eyebrow">EXPLORE THE WORKFLOW</div>
              <h2>A preview of the preview.</h2>
            </div>
          </div>
          <Demo />
          <p class="trickplay-credit">
            Trickplay generated by Media Trickplay Generator.
          </p>
          <p class="trickplay-credit">
            Preview thumbnails are scaled excerpts of Big Buck Bunny (© 2008,
            Blender Foundation /{" "}
            <a
              href="https://www.bigbuckbunny.org/"
              target="_blank"
              rel="noopener noreferrer"
            >
              www.bigbuckbunny.org
            </a>
            ) and Tears of Steel ((CC) Blender Foundation |{" "}
            <a
              href="https://mango.blender.org/"
              target="_blank"
              rel="noopener noreferrer"
            >
              mango.blender.org
            </a>
            ), both licensed under{" "}
            <a
              href="https://creativecommons.org/licenses/by/3.0/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Creative Commons Attribution 3.0
            </a>
            .
          </p>
        </section>
        <LibraryTest />
      </>
    )}
    <section class="wrap section">
      <div class="eyebrow">HOW IT WORKS</div>
      <h2>From setup to output.</h2>

      <div class="feature-grid">
        <Capture
          title={`${t.short} ${terminal.real ? "terminal interface" : "main menu"}`}
          asset={terminal.file}
          width={terminal.width}
          height={terminal.height}
          caption={terminal.real ? undefined : "Illustrated main menu."}
        />
        <Capture
          asset={walkthrough.file}
          width={walkthroughSize.width}
          height={walkthroughSize.height}
          video={video}
          title={
            video
              ? `${t.short} walkthrough video`
              : `${t.short} ${walkthrough.real ? "walkthrough" : "workflow"}`
          }
          caption={
            video
              ? "A recorded run, from setup to output."
              : walkthrough.real
                ? "From setup to processing output."
                : "Illustrated workflow."
          }
        />
      </div>
    </section>
    <section class="wrap section">
      <div class="feature-grid">
        {t.features.map(([title, copy], i) => (
          <article>
            <span class="feature-number">0{i + 1}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="wrap section">
      <div class="eyebrow">WHAT YOU GET</div>
      <h2>
        {t.slug === "cataloger"
          ? "Reports you can open anywhere."
          : t.slug === "trickplay-generator"
            ? "Useful output, close to your media."
            : "A varied library you can build and resume."}
      </h2>

      {t.slug === "cataloger" ? (
        <>
          <p>
            JSON reports include metadata, scope and summary information. TXT
            provides a readable report; Excel provides a workbook when
            XlsxWriter is installed.
          </p>
          <ReportPreviews />
        </>
      ) : t.slug === "trickplay-generator" ? (
        <pre><code>{'Movie.mkv\nMovie.trickplay/\n  320 - 10x10/\n    0.jpg\n    1.jpg'}</code></pre>
      ) : (
        <>
          <p>
            A managed output library contains copied videos, build manifests and
            a .mediadiversity-library.json marker. The exact destination layout
            follows the selected build mode.
          </p>
          <ul>
            <li>Selected source videos are copied, not moved.</li>
            <li>Manifests record progress for Build / Resume.</li>
            <li>Copy validation checks file length.</li>
          </ul>
        </>
      )}
    </section>
    <section class="wrap cta">
      <div>
        <h2>Make it part of your workflow.</h2>
        <p>Install, configure and complete your first run.</p>
      </div>
      <a class="button primary" href="#guide">
        Get started →
      </a>
    </section>
  </div>
  <section id="guide" data-product-panel aria-labelledby="guide-title">
    <div class="wrap document-heading">
      <h2 id="guide-title">Installation &amp; first run</h2>
      <a href="#troubleshooting">Troubleshooting ↓</a>
    </div>
    <ProductGuide tool={t} />
  </section>
  <section id="technical" data-product-panel aria-labelledby="technical-title">
    <div class="wrap document-heading">
      <h2 id="technical-title">Technical reference</h2>
    </div>
    <ProductTechnical tool={t} />
  </section>
  <div class="wrap product-help">
    <a
      href={`${github}${t.repo}/issues`}
      target="_blank"
      rel="noopener noreferrer"
    >
      Report an issue ↗
    </a>
    <a href={`${base}#tools`}>Explore the other tools →</a>
  </div>
</Layout>
